NOMDUCHAT_DOMAIN=nomduchat.com
ACME_EMAIL=admin@nomduchat.com

POSTGRES_USER=nomduchat
POSTGRES_PASSWORD=change-this-long-random-password
POSTGRES_DB=nomduchat

NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=https://nomduchat.com/api
WEB_APP_URL=https://nomduchat.com
CORS_ORIGINS=https://nomduchat.com,https://www.nomduchat.com

DATABASE_URL=postgresql://nomduchat:change-this-long-random-password@postgres:5432/nomduchat
DATABASE_SSL=false
DATABASE_RUN_MIGRATIONS=true
JWT_SECRET=change-this-64-character-random-secret-before-production

ABUSE_PROTECTION_ENABLED=true
ABUSE_TRUST_PROXY_HEADERS=true
ABUSE_HASH_SECRET=change-this-64-character-random-secret-before-production
TURNSTILE_REQUIRED=false
TURNSTILE_SECRET_KEY=

AI_PROVIDER_POLICY=production_rules
AI_MOCK_PROVIDER_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

OPENAI_BUDGET_USD=10
ANTHROPIC_BUDGET_USD=5
GEMINI_BUDGET_USD=10

PAYMENT_MOCK_CHECKOUT_ENABLED=false
PAYMENT_WEBHOOK_SECRET=change-this-webhook-secret
KASPI_CHECKOUT_URL=
KASPI_API_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RECEIPT_VAT_CODE=1
YOOKASSA_RETURN_URL=https://nomduchat.com/workspace/balance

PASSWORD_RESET_FROM_EMAIL=admin@nomduchat.com
PASSWORD_RESET_FROM_NAME=nomduchat
PASSWORD_RESET_TTL_MINUTES=30

VK_CLIENT_ID=
VK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_BZ_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_CLIENT_DOMAIN=nomduchat.com
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
MAILINGS_API_TOKEN=

STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=false
