{
  "name": "nomduchat",
  "private": true,
  "version": "0.1.0",
  "description": "nomduchat AI agent platform monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "npm --prefix apps/web run dev -- --host 127.0.0.1",
    "web:build": "npm run shared:build && npm --prefix apps/web run build",
    "web:preview": "npm run web:build && npm --prefix apps/web run preview -- --host 127.0.0.1",
    "api:dev": "npm --prefix apps/api run dev",
    "api:dev:postgres": "API_PERSISTENCE=postgres npm --prefix apps/api run dev",
    "api:build": "npm run shared:build && npm --prefix apps/api run build",
    "api:migrate": "npm run api:build && npm --prefix apps/api run migrate:build",
    "api:test": "npm --prefix apps/api run test",
    "web:e2e": "NOMDUCHAT_E2E_RUNNING=1 playwright test -c playwright.config.ts",
    "web:e2e:serve": "playwright test -c playwright.config.ts",
    "mailings:api": "node scripts/mailings-api.mjs",
    "shared:build": "npm --prefix packages/shared run build",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:ru:up": "docker compose --env-file infra/russia-vps/.env -f infra/russia-vps/docker-compose.yml up -d --build",
    "infra:ru:down": "docker compose --env-file infra/russia-vps/.env -f infra/russia-vps/docker-compose.yml down",
    "infra:ru:logs": "docker compose --env-file infra/russia-vps/.env -f infra/russia-vps/docker-compose.yml logs -f",
    "test": "npm run api:test",
    "check": "npm run api:build && npm run api:test && npm run web:build"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
