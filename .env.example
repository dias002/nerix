# Web
VITE_API_URL=http://127.0.0.1:4000

# API
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
API_BODY_LIMIT_BYTES=5000000
DATABASE_URL=postgresql://nomduchat:nomduchat@127.0.0.1:55432/nomduchat
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=false
DATABASE_RUN_MIGRATIONS=true
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me-locally
ACCESS_TOKEN_TTL_SECONDS=604800
API_PUBLIC_URL=http://127.0.0.1:4000
WEB_APP_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175
ADMIN_EMAILS=
PAYMENT_MOCK_CHECKOUT_ENABLED=true
PAYMENT_WEBHOOK_SECRET=
KASPI_CHECKOUT_URL=
KASPI_API_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://127.0.0.1:5173/workspace/balance
SMTP_BZ_API_KEY=
