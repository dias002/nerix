# Web
VITE_API_URL=https://api.nomduchat.com

# API
NODE_ENV=production
API_HOST=0.0.0.0
# Render sets PORT automatically. Leave API_PORT unset there.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nomduchat?sslmode=require
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL=true
DATABASE_RUN_MIGRATIONS=false
REDIS_URL=
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=604800
API_PUBLIC_URL=https://api.nomduchat.com
WEB_APP_URL=https://app.nomduchat.com
CORS_ORIGINS=https://app.nomduchat.com
ADMIN_EMAILS=admin@nomduchat.com
PAYMENT_WEBHOOK_SECRET=
KASPI_CHECKOUT_URL=
KASPI_API_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://app.nomduchat.com/workspace/balance
SMTP_BZ_API_KEY=
SMTP_BZ_BASE_URL=https://api.smtp.bz/v1
MAILINGS_API_TOKEN=
MAILINGS_API_USER_ID=production-user

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_API_VERSION=5.199

# Object storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=false

# AI providers
AI_PROVIDER_POLICY=production_rules
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.2
OPENAI_CODE_MODEL=gpt-5.2
OPENAI_IMAGE_MODEL=
OPENAI_VOICE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=
ANTHROPIC_CODE_MODEL=
GOOGLE_AI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_CODE_MODEL=
GEMINI_IMAGE_MODEL=
