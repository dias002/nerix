# Web
VITE_API_URL=https://api.nomduchat.com
VITE_YANDEX_METRIKA_ID=
VITE_YANDEX_VERIFICATION=

# API
NODE_ENV=production
API_HOST=0.0.0.0
# Render sets PORT automatically. Leave API_PORT unset there.
API_PERSISTENCE=postgres
API_BODY_LIMIT_BYTES=5000000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nomduchat?sslmode=require
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL=true
DATABASE_RUN_MIGRATIONS=false
REDIS_URL=
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=604800
API_PUBLIC_URL=https://api.nomduchat.com
WEB_APP_URL=https://www.nomduchat.com
CORS_ORIGINS=https://www.nomduchat.com,https://nomduchat.com,https://nomduchat.pages.dev
ABUSE_PROTECTION_ENABLED=true
ABUSE_TRUST_PROXY_HEADERS=true
ABUSE_HASH_SECRET=replace-with-a-long-random-secret
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=true
VITE_TURNSTILE_SITE_KEY=
ADMIN_EMAILS=admin@nomduchat.com
PAYMENT_MOCK_CHECKOUT_ENABLED=false
PAYMENT_WEBHOOK_SECRET=
KASPI_CHECKOUT_URL=
KASPI_API_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RECEIPT_VAT_CODE=1
YOOKASSA_RETURN_URL=https://www.nomduchat.com/workspace/balance
SMTP_BZ_API_KEY=
SMTP_BZ_BASE_URL=https://api.smtp.bz/v1
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_CLIENT_DOMAIN=nomduchat.com
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
PASSWORD_RESET_FROM_EMAIL=admin@nomduchat.com
PASSWORD_RESET_FROM_NAME=nomduchat
PASSWORD_RESET_TTL_MINUTES=30
TRANSACTIONAL_FROM_EMAIL=admin@nomduchat.com
TRANSACTIONAL_FROM_NAME=nomduchat
MAILINGS_API_TOKEN=
MAILINGS_API_USER_ID=production-user
TELEGRAM_MANAGER_BOT_USERNAME=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_API_VERSION=5.199

# Object storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=false

# AI providers
AI_PROVIDER_POLICY=production_rules
AI_MOCK_PROVIDER_ENABLED=false
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.2
OPENAI_CODE_MODEL=gpt-5.2
OPENAI_IMAGE_MODEL=
OPENAI_VOICE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=
ANTHROPIC_CODE_MODEL=
GOOGLE_AI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_CODE_MODEL=
GEMINI_IMAGE_MODEL=
GEMINI_VIDEO_MODEL=
GEMINI_MUSIC_MODEL=
HEYGEN_API_KEY=
HEYGEN_VIDEO_MODEL=
HEYGEN_AVATAR_VIDEO_MODEL=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_STYLE_ID=
HEYGEN_BRAND_KIT_ID=
HEYGEN_CALLBACK_URL=
HEYGEN_ORIENTATION=
