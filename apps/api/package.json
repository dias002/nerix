  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@types/pg": "^8.20.0",
    "fastify": "^5.0.0",
    "pg": "^8.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
