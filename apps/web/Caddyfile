{
	email {$ACME_EMAIL:admin@nomduchat.com}
}

{$NOMDUCHAT_DOMAIN:nomduchat.com}, www.{$NOMDUCHAT_DOMAIN:nomduchat.com} {
	encode zstd gzip

	@hashedAssets path /assets/*
	@publicAssets path /app-covers/* /app-placeholders/* /article-covers/* /avatar/* /furniture/* /icons/* /favicon.ico /favicon.png /apple-touch-icon.png /nomduchat-icon.jpg /site.webmanifest
	@frontendHtml {
		not path /api/* /assets/* /app-covers/* /app-placeholders/* /article-covers/* /avatar/* /furniture/* /icons/* /favicon.ico /favicon.png /apple-touch-icon.png /nomduchat-icon.jpg /site.webmanifest
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"
	header @publicAssets Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
	header @frontendHtml Cache-Control "no-cache"

	handle_path /api/* {
		reverse_proxy api:4000
	}

	handle /health {
		reverse_proxy api:4000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

api.{$NOMDUCHAT_DOMAIN:nomduchat.com} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	reverse_proxy api:4000
}
