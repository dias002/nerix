{
	email {$ACME_EMAIL:admin@nomduchat.com}
}

{$NOMDUCHAT_DOMAIN:nomduchat.com}, www.{$NOMDUCHAT_DOMAIN:nomduchat.com} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle_path /api/* {
		reverse_proxy api:4000
	}

	handle /health {
		reverse_proxy api:4000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

api.{$NOMDUCHAT_DOMAIN:nomduchat.com} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	reverse_proxy api:4000
}
